diff --git a/lib/nativeUi.ts b/lib/nativeUi.ts
new file mode 100644
index 0000000..b73d464
--- /dev/null
+++ b/lib/nativeUi.ts
@@ -0,0 +1,9 @@
+import strings from "./nativeUiStrings.json";
+import type { LanguageCode } from "./types";
+
+// Exact matching UI strings from the iOS release source c7893f8d7352df8ea818fcdec89bbc219c52672f.
+// Other website copy remains explicitly English until a matching translation is available.
+export type NativeUiKey = keyof typeof strings.en;
+export function nativeUi(language: LanguageCode, key: NativeUiKey): string {
+  return strings[language][key];
+}
