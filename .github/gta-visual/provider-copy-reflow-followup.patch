diff --git a/lib/providerExcerpt.ts b/lib/providerExcerpt.ts
new file mode 100644
index 0000000..35eaff3
--- /dev/null
+++ b/lib/providerExcerpt.ts
@@ -0,0 +1,9 @@
+/** Keep provider wording intact while making clear when a preview is shortened. */
+export function providerExcerpt(item: { description?: string; summary: string }, limit = 320) {
+  const text = (item.description || item.summary).replace(/\s+/g, " ").trim();
+  if (text.length <= limit) return text;
+  const sentence = text.slice(0, limit + 1).match(/[\s\S]*[.!?](?=\s|$)/)?.[0];
+  if (sentence && sentence.length >= limit * 0.4) return sentence.trimEnd();
+  const boundary = text.lastIndexOf(" ", limit);
+  return `${text.slice(0, boundary > 0 ? boundary : limit).replace(/[,:;—–-]+$/, "")}…`;
+}
diff --git a/lib/providerExcerpt.test.ts b/lib/providerExcerpt.test.ts
new file mode 100644
index 0000000..6b69309
--- /dev/null
+++ b/lib/providerExcerpt.test.ts
@@ -0,0 +1,10 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { providerExcerpt } from "./providerExcerpt";
+
+test("provider previews preserve actual source text instead of inventing a generic summary", () => {
+  const text = "Join a hands-on bookmark workshop at the library.";
+  assert.equal(providerExcerpt({ description: text, summary: "A different summary" }), text);
+  assert.equal(providerExcerpt({ description: "", summary: text }), text);
+  assert.equal(providerExcerpt({ description: text, summary: "" }, 25), "Join a hands-on bookmark…");
+});
